[Unit]
Description=Voice dictation push-to-talk (hold Right Ctrl)
After=graphical-session.target ydotool.service
Wants=ydotool.service

[Service]
Type=simple
# Session plumbing (%t = XDG_RUNTIME_DIR, %h = home)
Environment=WAYLAND_DISPLAY=wayland-0
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=%t/bus
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
# Dictation config (see README)
# Mics for dictation, best first — each take uses the first one that is present,
# so a flat headset costs one take rather than the session. Recording from the
# system default instead means a connected headset silently takes dictation over.
# Names come from `pactl list short sources`; leave unset to follow the default.
#Environment=VD_SOURCE=bluez_input.AA:BB:CC:DD:EE:FF,alsa_input.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Mic1__source
Environment=VOICE_DICTATE_LANG=ru
Environment=VD_PTT_KEY=KEY_RIGHTCTRL
Environment=VD_PTT_MOD=
ExecStart=%h/.local/share/voice-dictate/venv/bin/python %h/.local/share/voice-dictate/ptt_daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
